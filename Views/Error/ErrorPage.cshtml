@{
    ViewData["Title"] = "خطأ في النظام";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow p-5">
                <h1 class="display-1 text-danger fw-bold">⚠️</h1>
                <h2 class="mb-3 text-secondary">عذراً حدث خطأ ما</h2>
                <p class="lead text-muted">@ViewData["ErrorMessage"]</p>
                <hr />
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">العودة للرئيسية</a>
                </div>
            </div>
        </div>
    </div>
</div>