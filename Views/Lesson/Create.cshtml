@model OnlineCoursePlatform.Models.Lesson

@{
    ViewData["Title"] = "إضافة درس جديد";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">إضافة درس جديد للدورة: @ViewBag.CourseTitle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="CourseId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">عنوان الدرس</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">وصف الدرس</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">رفع ملف فيديو من الجهاز (بدون YouTube)</label>
                            <input type="file" name="videoFile" class="form-control" accept=".mp4,.webm,.ogg" />
                            <small class="text-muted">الصيغ المدعومة MP4 / WEBM / OGG، حتى 500MB. يمكن أيضاً إدخال رابط فيديو خارجي أدناه.</small>
                        </div>
                        <div class="mb-3">
                            <label asp-for="VideoUrl" class="form-label">أو رابط الفيديو (اختياري)</label>
                            <input asp-for="VideoUrl" class="form-control" />
                            <span asp-validation-for="VideoUrl" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label">ترتيب العرض</label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationInMinutes" class="form-label">المدة (بالدقائق)</label>
                                <input asp-for="DurationInMinutes" class="form-control" type="number" />
                                <span asp-validation-for="DurationInMinutes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsFreePreview" class="form-check-input" type="checkbox" />
                            <label asp-for="IsFreePreview" class="form-check-label">معاينة مجانية؟</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">حفظ الدرس</button>
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-secondary">العودة لتفاصيل الدورة</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>