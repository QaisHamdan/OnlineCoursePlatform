@model OnlineCoursePlatform.Models.Lesson

@{
    ViewData["Title"] = Model.Title;

    // دالة لاستخراج معرف يوتيوب وتحويله لرابط تضمين صحيح
    string GetEmbedUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "";
        if (url.StartsWith("www.youtube.com", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("youtu.be", StringComparison.OrdinalIgnoreCase))
            url = "https://" + url;
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)) return url;
        string? videoId = null;

        if (uri.Host.Contains("youtu.be", StringComparison.OrdinalIgnoreCase))
            videoId = uri.AbsolutePath.Trim('/');
        else if (uri.Host.Contains("youtube.com", StringComparison.OrdinalIgnoreCase))
        {
            if (uri.AbsolutePath.StartsWith("/embed/", StringComparison.OrdinalIgnoreCase))
                videoId = uri.AbsolutePath.Substring("/embed/".Length);
            else if (uri.AbsolutePath.StartsWith("/shorts/", StringComparison.OrdinalIgnoreCase))
                videoId = uri.AbsolutePath.Substring("/shorts/".Length);
            else
                videoId = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("v", out var value) ? value.ToString() : null;
        }

        return !string.IsNullOrWhiteSpace(videoId)
            ? $"https://www.youtube-nocookie.com/embed/{videoId}"
            : url;
    }
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- شريط التنقل العلوي -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-right me-1"></i> العودة لتفاصيل الدورة
                </a>
                <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><i class="bi bi-clock me-1"></i> @Model.DurationInMinutes دقيقة</span>
            </div>

            <!-- بطاقة الدرس الرئيسية -->
            @if (ViewBag.IsIntroduction == true) { <div class="alert alert-info">هذا فيديو المقدمة المجاني والمتاح لجميع زوار المنصة.</div> }
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden bg-white">
                <!-- هيدر الدرس بتصميم أنيق وواضح -->
                <div class="card-header bg-light text-dark p-3 text-right border-bottom">
                    <h3 class="mb-0 fw-bold text-primary">@Model.Title</h3>
                </div>

                <div class="card-body p-4 text-right">
                    <!-- مشغل الفيديو بتصميم عريض ومرتب -->
                    @if (!string.IsNullOrEmpty(Model.VideoUrl))
                    {
                        <div class="mb-4 shadow-sm rounded-4 overflow-hidden bg-black">
                            @if (Model.VideoUrl.StartsWith("/uploads/videos/", StringComparison.OrdinalIgnoreCase))
                            { <video controls playsinline preload="metadata" style="width:100%;max-height:520px"><source src="@Model.VideoUrl" type="video/@System.IO.Path.GetExtension(Model.VideoUrl).TrimStart('.').ToLowerInvariant()" />متصفحك لا يدعم تشغيل الفيديو.</video> }
                            else
                            { <div style="position:relative;width:100%;height:480px"><iframe src="@GetEmbedUrl(Model.VideoUrl)" title="Lesson Video" style="width:100%;height:100%;border:none" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div> }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center rounded-3 p-4">لا يوجد فيديو مرفق لهذا الدرس حالياً.</div>
                    }

                    <hr class="my-4" />

                    <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-file-text me-2"></i>وصف الدرس:</h5>
                    <p class="lead fs-6 text-dark lh-lg" style="white-space: pre-line;">@Model.Description</p>
                    @if (User.Identity?.IsAuthenticated == true && ViewBag.IsIntroduction != true && !User.IsInRole("Instructor") && !User.IsInRole("Admin"))
                    {
                        <form asp-controller="Lesson" asp-action="MarkCompleted" method="post" class="mt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lessonId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> تم إكمال الدرس</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>