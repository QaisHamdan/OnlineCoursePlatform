@model IEnumerable<OnlineCoursePlatform.Models.ApplicationUser>

@{
    ViewData["Title"] = "طلبات انضمام المدربين";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-person-badge me-2"></i> طلبات انضمام المدربين المعلقة</h2>
        <span class="badge bg-warning text-dark fs-6">الطلبات قيد الانتظار: @Model.Count()</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center py-4 mb-0">
                    <i class="bi bi-info-circle me-2"></i> لا توجد طلبات انضمام جديدة قيد المراجعة حالياً.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>الاسم الكامل</th>
                                <th>البريد الإلكتروني</th>
                                <th>النبذة التعريفية (Bio)</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@user.FirstName @user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrEmpty(user.Bio) ? "لا توجد نبذة" : user.Bio)</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <form asp-action="ApproveInstructor" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg"></i> موافقة
                                                </button>
                                            </form>
                                            <form asp-action="RejectInstructor" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-lg"></i> رفض
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>