@model IEnumerable<OnlineCoursePlatform.Models.Review>

@{
    ViewData["Title"] = "إدارة التعليقات والمراجعات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-chat-dots me-2"></i> إدارة التعليقات والمراجعات</h2>
        <span class="badge bg-secondary fs-6">إجمالي التعليقات: @Model.Count()</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>الطالب</th>
                            <th>الدورة</th>
                            <th>التقييم</th>
                            <th>التعليق</th>
                            <th>التاريخ</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var review in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@(review.Student?.UserName ?? "مستخدم محذوف")</td>
                                    <td>@(review.Course?.Title ?? "دورة محذوفة")</td>
                                    <td>
                                        <span class="text-warning">
                                            @for (int i = 0; i < review.Rating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </span>
                                    </td>
                                    <td>@review.Comment</td>
                                    <td>@review.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center">
                                        <form asp-action="DeleteComment" asp-route-id="@review.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا التعليق نهائياً؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> حذف
                                            </button>
                                        </form>
                                        @if (review.Student != null && review.Student.IsActive)
                                        {
                                            <form asp-action="BlockUser" method="post" class="d-inline" onsubmit="return confirm('هل تريد إيقاف حساب هذا المستخدم؟');">
                                                @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@review.StudentId" />
                                                <button type="submit" class="btn btn-sm btn-dark"><i class="bi bi-person-slash"></i> Block User</button>
                                            </form>
                                        } else { <span class="badge bg-danger">الحساب موقوف</span> }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">لا توجد تعليقات أو مراجعات حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>