@model IEnumerable<OnlineCoursePlatform.Models.Payment>

@{
    ViewData["Title"] = "سجل المدفوعات المالية";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-cash-stack me-2"></i> سجل المدفوعات والمالية</h2>
        <span class="badge bg-success fs-6">إجمالي العمليات: @Model.Count()</span>
    </div>


    <form method="get" asp-action="Payments" class="card card-body shadow-sm border-0 mb-3"><div class="row g-2 align-items-end">
      <div class="col-md-2"><label class="form-label">حالة الدفع</label><select name="status" class="form-select"><option value="">الكل</option>@foreach(string st in (ViewBag.Statuses as IEnumerable<string> ?? Enumerable.Empty<string>())){<option value="@st" selected="@(ViewBag.Status==st)">@st</option>}</select></div>
      <div class="col-md-2"><label class="form-label">وسيلة الدفع</label><select name="provider" class="form-select"><option value="">الكل</option>@foreach(string pr in (ViewBag.Providers as IEnumerable<string> ?? Enumerable.Empty<string>())){<option value="@pr" selected="@(ViewBag.Provider==pr)">@pr</option>}</select></div>
      <div class="col-md-2"><label class="form-label">من تاريخ</label><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control"/></div><div class="col-md-2"><label class="form-label">إلى تاريخ</label><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control"/></div>
      <div class="col-md-3"><label class="form-label">بحث</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="رقم المعاملة / البريد / الدورة"/></div><div class="col-md-1"><button class="btn btn-primary w-100">تصفية</button></div></div><div class="mt-2"><a asp-action="Payments" class="btn btn-sm btn-outline-secondary">مسح الفلاتر</a></div></form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>رقم المعاملة (Transaction ID)</th>
                            <th>الطالب</th>
                            <th>الدورة المدفوعة</th>
                            <th>المبلغ</th>
                            <th>وسيلة الدفع</th>
                            <th>الحالة</th>
                            <th>تاريخ الدفع</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var pay in Model)
                            {
                                <tr>
                                    <td><code>@pay.TransactionId</code></td>
                                    <td class="fw-bold">@(pay.Student?.UserName ?? "غير متوفر")</td>
                                    <td>@(pay.Course?.Title ?? "غير متوفر")</td>
                                    <td class="text-success fw-bold">$@pay.Amount</td>
                                    <td>@pay.PaymentProvider</td>
                                    <td>
                                        <span class="badge bg-success">@pay.PaymentStatus</span>
                                    </td>
                                    <td>@pay.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">لا توجد عمليات دفعة مسجلة حتى الآن.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>