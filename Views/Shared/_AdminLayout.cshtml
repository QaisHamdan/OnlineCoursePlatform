<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - منصة التعلم</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<style>
		:root {
			--navy: #102b4d;
			--navy2: #1c426c;
			--orange: #f2a51a;
			--bg: #f4f7fb;
			--ink: #26364b
		}

		* {
			font-family: 'Cairo',sans-serif
		}

		body {
			background: var(--bg);
			color: var(--ink)
		}

		.admin-shell {
			min-height: 100vh
		}

		.admin-sidebar {
			background: linear-gradient(165deg,var(--navy),#091a30);
			color: #fff;
			min-height: 100vh;
			padding: 25px 16px;
			box-shadow: 0 8px 30px #102b4d20
		}

		.admin-brand {
			color: #fff;
			font-weight: 900;
			font-size: 21px;
			text-align: center;
			padding: 8px 4px 24px;
			border-bottom: 1px solid #ffffff25;
			margin-bottom: 20px
		}

			.admin-brand i {
				color: var(--orange);
				font-size: 25px
			}

		.admin-sidebar .nav-link {
			color: #dce6f2;
			border-radius: 9px;
			padding: 11px 13px;
			margin: 4px 0;
			font-size: 13px;
			font-weight: 700;
			transition: .2s
		}

			.admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
				background: var(--orange);
				color: var(--navy);
				text-decoration: none
			}

			.admin-sidebar .nav-link i {
				margin-left: 8px;
				font-size: 16px
			}

		.admin-separator {
			border-color: #ffffff25;
			margin: 20px 5px
		}

		.admin-action {
			display: block;
			text-align: center;
			border-radius: 9px;
			padding: 11px 12px;
			font-weight: 800;
			font-size: 13px;
			text-decoration: none;
			margin-top: 9px
		}

		.back-site {
			background: #fff;
			color: var(--navy)
		}

			.back-site:hover {
				background: var(--orange);
				color: var(--navy);
				text-decoration: none
			}

		.logout-btn {
			width: 100%;
			border: 0;
			background: #c94048;
			color: #fff;
			cursor: pointer
		}

			.logout-btn:hover {
				background: #a92f38
			}

		.admin-main {
			padding: 32px;
			min-width: 0
		}

			.admin-main .card {
				border: 1px solid #e6ebf2;
				border-radius: 13px;
				box-shadow: 0 6px 22px #102b4d0a
			}

			.admin-main h1, .admin-main h2, .admin-main h3, .admin-main h4 {
				color: var(--navy);
				font-weight: 800
			}

			.admin-main .btn-primary {
				background: var(--navy2);
				border-color: var(--navy2)
			}

			.admin-main .btn-warning {
				background: var(--orange);
				border-color: var(--orange);
				color: var(--navy)
			}

		@@media(max-width:767px) {
			.admin-sidebar {
				min-height: auto
			}

			.admin-main {
				padding: 20px 14px
			}
		}
	</style>
</head>
<body>
	<div class="container-fluid admin-shell">
		<div class="row">
			<nav class="col-md-3 col-lg-2 admin-sidebar">
				<div class="admin-brand"><i class="bi bi-mortarboard-fill"></i><div>منصة التعلم</div><small style="color:#aebed1;font-size:11px">لوحة الإدارة</small></div>
				<ul class="nav flex-column">
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i>الإحصائيات العامة</a></li>
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i>المستخدمون</a></li>
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-person-badge"></i>المدربون والطلبات</a></li>
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Courses" ? "active" : "")" asp-controller="Admin" asp-action="Courses"><i class="bi bi-journal-code"></i>الدورات</a></li>
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Comments" ? "active" : "")" asp-controller="Admin" asp-action="Comments"><i class="bi bi-chat-dots"></i>التعليقات والمراجعات</a></li>
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Payments" ? "active" : "")" asp-controller="Admin" asp-action="Payments"><i class="bi bi-cash-stack"></i>المدفوعات</a></li>
					<li><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminsManagement" ? "active" : "")" asp-controller="Admin" asp-action="AdminsManagement"><i class="bi bi-shield-lock"></i>إدارة الأدمنز</a></li>
				</ul><hr class="admin-separator" />
				<a class="admin-action back-site" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> العودة للموقع</a>
				<form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit" class="admin-action logout-btn"><i class="bi bi-box-arrow-left"></i> تسجيل الخروج</button></form>
			</nav>
			<main class="col-md-9 col-lg-10 admin-main">
				@if (TempData["Error"] != null)
				{
					<div class="alert alert-danger">@TempData["Error"]</div>
				}
				@if (TempData["Success"] != null)
				{
					<div class="alert alert-success">@TempData["Success"]</div>
				}
				@RenderBody()
			</main>
		</div>
	</div>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>