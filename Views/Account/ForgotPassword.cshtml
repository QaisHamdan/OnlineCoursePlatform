@model OnlineCoursePlatform.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "نسيت كلمة المرور";
}

<section class="inner-page-hero"><div class="container"><span>استعادة الحساب</span><h1>نسيت كلمة المرور؟</h1><p>أدخل بريدك الإلكتروني للحصول على رابط إعادة التعيين.</p></div></section>
<div class="container platform-page form-page" style="max-width: 620px;" dir="rtl">
    <div class="card platform-form-card shadow-sm border-0 p-4 rounded-4 text-right">
        <h3 class="text-center mb-4">نسيت كلمة المرور؟</h3>

        <!-- عرض رابط المحاكاة في حال تم توليده بنجاح -->
        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-success mb-4 text-start" dir="ltr">
                <p class="mb-1 fw-bold text-center text-dark" dir="rtl"><strong>[وضع المحاكاة للمهندس]:</strong></p>
                <a href="@TempData["ResetLink"]" class="d-block text-break text-primary small">@TempData["ResetLink"]</a>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني:</label>
                <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">إرسال رابط الاستعادة</button>
        </form>
    </div>
</div>