@model OnlineCoursePlatform.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "إنشاء حساب جديد";
}

<section class="inner-page-hero"><div class="container"><span>منصة التعلم</span><h1>إنشاء حساب جديد</h1><p>أنشئ حسابك وابدأ باكتساب مهارات جديدة.</p></div></section>
<div class="container platform-page auth-page">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4 p-4 auth-card">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">انضم إلى منصتنا</h2>
                    <p class="text-muted">انشئ حسابك وابدأ رحلتك التعليمية معنا</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="FirstName" class="form-control" placeholder="الاسم الأول" />
                                <label asp-for="FirstName">الاسم الأول</label>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="LastName" class="form-control" placeholder="اسم العائلة" />
                                <label asp-for="LastName">اسم العائلة</label>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Email">البريد الإلكتروني</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <select asp-for="Role" class="form-select">
                            <option value="Student">طالب (تعلم الدورات)</option>
                            <option value="Instructor">مدرب (أشرك دوراتك وطور طلابك)</option>
                        </select>
                        <label asp-for="Role">نوع الحساب</label>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                        <label asp-for="Password">كلمة المرور</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                        <label asp-for="ConfirmPassword">تأكيد كلمة المرور</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-primary rounded-pill mb-3">تسجيل الحساب</button>

                    <div class="text-center">
                        <p class="text-muted">لديك حساب بالفعل؟ <a asp-action="Login" class="text-decoration-none fw-bold text-primary">سجل دخولك الآن</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}