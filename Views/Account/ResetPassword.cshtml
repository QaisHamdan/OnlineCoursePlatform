@model OnlineCoursePlatform.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0 p-4 rounded-4">
        <h3 class="text-center mb-4">تعيين كلمة مرور جديدة</h3>
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold">كلمة المرور الجديدة:</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">تأكيد كلمة المرور:</label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2">حفظ كلمة المرور</button>
        </form>
    </div>
</div>