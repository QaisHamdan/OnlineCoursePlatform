@{
    ViewData["Title"] = "تأكيد استعادة كلمة المرور";
}

<div class="container mt-5" dir="rtl" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-5 rounded-4 text-center">
        <h3 class="text-success mb-3">تم إرسال الطلب</h3>
        <p class="text-muted mb-4">إذا كان البريد الإلكتروني مسجلاً لدينا، فقد تم إنشاء رابط استعادة كلمة المرور الخاص بك.</p>

        <!-- صندوق المحاكاة لعرض الرابط للمهندس مباشرة -->
        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-success text-center mb-4" dir="rtl">
                <p class="mb-2 fw-bold text-dark">رابط إعادة تعيين كلمة المرور :</p>
                <a href="@TempData["ResetLink"]" class="btn btn-warning text-dark font-weight-bold px-4 py-2">
                    <i class="ti-key"></i> اضغط هنا لإنشاء كلمة سر جديدة
                </a>
            </div>
        }

        <div>
            <a asp-action="Login" class="btn btn-secondary px-4 py-2">العودة لتسجيل الدخول</a>
        </div>
    </div>
</div>