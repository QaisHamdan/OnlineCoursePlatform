@model OnlineCoursePlatform.ViewModels.UserProfileViewModel
@{ ViewData["Title"] = "الملف الشخصي"; var displayName = $"{Model.FirstName} {Model.LastName}".Trim(); var initials = (string.IsNullOrEmpty(Model.FirstName) ? "" : Model.FirstName.Substring(0, 1)) + (string.IsNullOrEmpty(Model.LastName) ? "" : Model.LastName.Substring(0, 1)); }
<section class="inner-page-hero"><div class="container"><span>حسابك الشخصي</span><h1>الملف الشخصي</h1><p>إدارة معلوماتك وصورتك الشخصية على منصة التعلم.</p></div></section>
<div class="container platform-page py-4" dir="rtl"><div class="row justify-content-center"><div class="col-lg-9">
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
<div class="profile-panel"><div class="profile-cover"></div><div class="profile-content">
<form asp-action="Profile" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="profile-head"><div class="profile-avatar-wrap"><div class="profile-avatar-ring"><div class="profile-avatar-inner">
@if(!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)){<img id="profilePreview" src="@Model.ProfilePictureUrl" alt="الصورة الشخصية"/>}else{<div id="profileInitials" class="profile-initials">@(string.IsNullOrWhiteSpace(initials)?"؟":initials)</div><img id="profilePreview" src="" alt="الصورة الشخصية" style="display:none"/>}
</div></div><label for="ProfilePicture" class="avatar-upload"><i class="bi bi-camera-fill"></i></label></div>
<div class="profile-title"><h2>@(string.IsNullOrWhiteSpace(displayName)?"مستخدم منصة التعلم":displayName)</h2><p>@Model.Email</p><div class="profile-role">@string.Join(" · ",Model.Roles.Select(r=>r=="Admin"?"مدير":r=="Instructor"?"مدرب":"طالب"))</div></div></div>
<input asp-for="ProfilePicture" id="ProfilePicture" type="file" accept=".jpg,.jpeg,.png,.webp" class="d-none"/><span asp-validation-for="ProfilePicture" class="text-danger"></span><small class="text-muted d-block mb-4">اضغط على أيقونة الكاميرا لإضافة أو تغيير الصورة (JPG / PNG / WEBP، حتى 5MB).</small>
<div class="profile-section-title">المعلومات الشخصية</div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label">الاسم الأول</label><input asp-for="FirstName" class="form-control"/><span asp-validation-for="FirstName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label">اسم العائلة</label><input asp-for="LastName" class="form-control"/><span asp-validation-for="LastName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Email" class="form-label">البريد الإلكتروني</label><input asp-for="Email" class="form-control" readonly/></div><div class="col-md-6 mb-3"><label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label><input asp-for="PhoneNumber" class="form-control"/></div><div class="col-12 mb-3"><label asp-for="Bio" class="form-label">نبذة عني</label><textarea asp-for="Bio" class="form-control" rows="4" placeholder="شارك الآخرين نبذة بسيطة عنك..."></textarea></div></div>
@if(!string.IsNullOrEmpty(Model.InstructorStatus)){<div class="alert alert-info">حالة طلب المدرب: @Model.InstructorStatus</div>}
<div class="d-flex flex-wrap justify-content-between align-items-center mt-3"><a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">العودة للموقع</a><div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary px-4">حفظ التعديلات</button>@if(Model.Roles.Contains("Student") && Model.InstructorStatus!="Approved" && Model.InstructorStatus!="Pending"){<a asp-action="BecomeInstructor" class="btn btn-outline-success">طلب الانضمام كمدرب</a>}</div></div>
</form></div></div></div></div></div>
@section Scripts{<script>document.getElementById('ProfilePicture')?.addEventListener('change',function(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const img=document.getElementById('profilePreview');img.src=r.result;img.style.display='block';const initials=document.getElementById('profileInitials');if(initials)initials.style.display='none';};r.readAsDataURL(f);});</script>}
