@model IEnumerable<OnlineCoursePlatform.Models.Course>

@{
    ViewData["Title"] = "الدورات التدريبية";
}

<section class="inner-page-hero"><div class="container"><span>اكتشف المعرفة</span><h1>الدورات التدريبية</h1><p>اختر الدورة التي تناسب أهدافك وابدأ التعلم من أي مكان.</p></div></section>
<div class="container platform-page" dir="rtl">

    <!-- قسم البحث والفلاتر (مطابق لمتطلبات المهندس) -->
    <form asp-controller="Course" asp-action="Index" method="get" class="bg-light p-4 rounded shadow-sm mb-5">
        <div class="row align-items-center g-3">

            <!-- حقل البحث (العنوان، الوصف، أو المدرب) -->
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="input-group">
                    <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="ابحث عن دورة أو مدرب...">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit"><i class="ti-search"></i> بحث</button>
                    </div>
                </div>
            </div>

            <!-- فلاتر الفئات (Category) -->
            <div class="col-md-3 mb-2 mb-md-0">
                <select name="categoryId" class="form-control" onchange="this.form.submit()">
                    <option value="">كل التصنيفات</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories as List<OnlineCoursePlatform.Models.Category>)
                        {
                            if (ViewData["CurrentCategory"] != null && (int)ViewData["CurrentCategory"] == cat.Id)
                            {
                                <option value="@cat.Id" selected="selected">@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    }
                </select>
            </div>

            <!-- فلاتر السعر (مجاني / مدفوع) -->
            <div class="col-md-3 mb-2 mb-md-0">
                <select name="priceFilter" class="form-control" onchange="this.form.submit()">
                    <option value="">كل الأسعار</option>
                    <option value="free" selected="@(ViewData["CurrentPrice"]?.ToString() == "free")">مجاني</option>
                    <option value="paid" selected="@(ViewData["CurrentPrice"]?.ToString() == "paid")">مدفوع</option>
                </select>
            </div>

            <!-- زر إلغاء الفلاتر -->
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-secondary btn-block text-white w-100">إلغاء الفلاتر</a>
            </div>
        </div>
    </form>

    <!-- عرض الدورات -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-4">لا توجد دورات مطابقة لبحثك.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden catalog-course-card">
                        <!-- عرض صورة الغلاف إذا كانت موجودة، وإلا عرض صورة افتراضية -->
                        @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                        {
                            <img src="@item.ThumbnailUrl" class="card-img-top catalog-course-image" alt="@item.Title" />
                        }


                        <div class="card-body text-right">
                            <span class="badge bg-secondary mb-2">@(item.Category?.Name ?? "عام")</span>
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="card-text text-muted small">
                                @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                            </p>
                            <p class="fw-bold text-success fs-5 mb-1">السعر: @item.Price.ToString("0.00") $</p>
                            <p class="small text-secondary mb-0">المستوى: @item.Level</p>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex gap-2 pb-3 px-3 justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                                <i class="bi bi-eye"></i> عرض التفاصيل
                            </a>


                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>