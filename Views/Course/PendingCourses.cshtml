@model IEnumerable<OnlineCoursePlatform.Models.Course>

@{
    ViewData["Title"] = "الدورات بانتظار الموافقة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-clock-history me-2"></i> الدورات بانتظار موافقة الإدارة</h2>
        <span class="badge bg-warning text-dark fs-6">الدورات المعلقة: @Model.Count()</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center py-4 mb-0">
                    <i class="bi bi-info-circle me-2"></i> لا توجد دورات جديدة بانتظار الموافقة حالياً.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>صورة الغلاف</th>
                                <th>عنوان الدورة</th>
                                <th>المدرب</th>
                                <th>السعر</th>
                                <th>التصنيف</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@course.ThumbnailUrl" alt="Thumbnail" style="width: 60px; height: 40px; object-fit: cover;" class="rounded" />
                                    </td>
                                    <td class="fw-bold">@course.Title</td>
                                    <td>@course.Instructor?.UserName</td>
                                    <td>@course.Price $</td>
                                    <td>@course.Category?.Name</td>
                                    <td class="text-center">
                                        <form asp-action="ApproveCourse" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@course.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-lg"></i> موافقة ونشر
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>