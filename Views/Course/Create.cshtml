@model OnlineCoursePlatform.Models.Course

@{
    ViewData["Title"] = "إنشاء دورة جديدة";
}

<section class="inner-page-hero"><div class="container"><span>مساحة المدرب</span><h1>إنشاء دورة جديدة</h1><p>أضف تفاصيل الدورة وصورتها لتجهيزها للنشر.</p></div></section>
<div class="container platform-page" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden create-course-card">

                <!-- رأس البطاقة -->
                <div class="card-header bg-primary text-white p-4 text-start">
                    <h4 class="mb-1 text-white fw-bold"><i class="bi bi-plus-circle me-2"></i> إضافة دورة تدريبية جديدة</h4>
                    <p class="mb-0 text-white-50 small">قم بتعبئة تفاصيل الدورة أدناه لإضافتها بنجاح</p>
                </div>

                <!-- محتوى النموذج -->
                <div class="card-body p-4 p-md-5 text-end">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                        <!-- عنوان الدورة -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">عنوان الدورة</label>
                            <input asp-for="Title" class="form-control text-end" placeholder="أدخل عنوان الدورة..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- وصف الدورة -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">وصف الدورة</label>
                            <textarea asp-for="Description" class="form-control text-end" rows="4" placeholder="اكتب تفاصيل ومحتوى الدورة..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- السعر والمستوى -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6" dir="rtl">
                                <label asp-for="Price" class="form-label fw-bold d-block text-end">السعر ($)</label>
                                <div class="d-flex flex-wrap gap-3 mb-3">
                                    <label class="form-check form-check-inline border rounded-3 px-3 py-2">
                                        <input class="form-check-input" type="radio" name="isFreeCourse" id="courseFree" value="true" checked />
                                        <span class="form-check-label fw-bold">مجاني</span>
                                    </label>
                                    <label class="form-check form-check-inline border rounded-3 px-3 py-2">
                                        <input class="form-check-input" type="radio" name="isFreeCourse" id="coursePaid" value="false" />
                                        <span class="form-check-label fw-bold">مدفوع</span>
                                    </label>
                                </div>
                                <input asp-for="Price" id="coursePrice" class="form-control text-end" type="number" step="0.01" min="0" value="0" placeholder="أدخل سعر الدورة" readonly />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6" dir="rtl">
                                <label asp-for="Level" class="form-label fw-bold d-block text-end">المستوى</label>
                                <select asp-for="Level" class="form-select text-end" style="padding-right: 1.75rem; background-position: right 0.75rem center;">
                                    <option value="Beginner">مبتدئ</option>
                                    <option value="Intermediate">متوسط</option>
                                    <option value="Advanced">متقدم</option>
                                </select>
                                <span asp-validation-for="Level" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- التصنيف -->
                        <div class="mb-3" dir="rtl">
                            <label asp-for="CategoryId" class="form-label fw-bold d-block text-end">التصنيف</label>
                            <select asp-for="CategoryId" class="form-select text-end" asp-items="ViewBag.CategoryId" style="padding-right: 1.75rem; background-position: right 0.75rem center;">
                                <option value="">-- اختر التصنيف المناسب --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- صورة الغلاف -->
                        <div class="mb-3 p-3 bg-light rounded-3 border" dir="rtl">
                            <label class="form-label fw-bold mb-2 d-block text-end">صورة غلاف الدورة (Thumbnail)</label>
                            <input type="file" name="coverImage" class="form-control" accept="image/*" />
                            <span class="text-muted small d-block mt-1 text-end">يفضل اختيار صورة واضحة بنسبة (16:9)</span>
                        </div>

                        <!-- حالة الدورة -->
                        <div class="mb-4" dir="rtl">
                            <label asp-for="Status" class="form-label fw-bold d-block text-end">حالة الدورة</label>
                            <select asp-for="Status" class="form-select text-end" style="padding-right: 1.75rem; background-position: right 0.75rem center;">
                                <option value="Draft">مسودة (Draft)</option>
                                <option value="Published">منشورة (Published)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <!-- الأزرار -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">العودة للقائمة</a>
                            <button type="submit" class="btn btn-success px-5">
                                <i class="bi bi-check-circle me-1"></i> حفظ ونشر الدورة
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (() => {
            const free = document.getElementById('courseFree');
            const paid = document.getElementById('coursePaid');
            const price = document.getElementById('coursePrice');
            const syncPriceMode = () => {
                const isFree = free.checked;
                price.readOnly = isFree;
                price.required = !isFree;
                if (isFree) price.value = '0';
                else if (Number(price.value) <= 0) price.value = '';
            };
            free.addEventListener('change', syncPriceMode);
            paid.addEventListener('change', syncPriceMode);
            syncPriceMode();
        })();
    </script>
}