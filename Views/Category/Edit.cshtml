@model OnlineCoursePlatform.Models.Category
@{
    ViewData["Title"] = "تعديل الفئة";
}
<div class="container mt-4" style="max-width: 600px;">
    <h2 class="fw-bold mb-4">تعديل الفئة</h2>
    <form asp-action="Edit" method="post" class="card shadow-sm border-0 p-4">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">اسم الفئة</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">الوصف</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
            <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
        </div>
    </form>
</div>